{
  "format": "blockliner-ui-pack",
  "version": 1,
  "id": "python/customtkinter",
  "language": "python",
  "label": "customtkinter",
  "description": "Modern-looking rounded widgets built on tkinter. Needs one install: pip install customtkinter.",
  "priority": 10,
  "imports": [
    "import customtkinter as ctk",
    "import types"
  ],
  "header": [],
  "root_types": [
    "window",
    "popup"
  ],
  "run": "{ui}.{root}.mainloop()",
  "preview": "boxes",
  "order": [
    "window",
    "popup",
    "frame",
    "label",
    "button",
    "checkbutton",
    "entry",
    "text",
    "combobox",
    "radiobutton",
    "switch",
    "scale",
    "progressbar",
    "optionmenu",
    "segmented",
    "scrollframe"
  ],
  "quote": "python",
  "function": {
    "def": "def {fname}():",
    "indent": "    ",
    "ret": "return types.SimpleNamespace({pairs})",
    "pair": "{name}={name}",
    "call": "{ui} = {fname}()"
  },
  "layouts": {
    "grid": {
      "props": [
        {
          "key": "row",
          "label": "Row",
          "kind": "int",
          "default": 0
        },
        {
          "key": "column",
          "label": "Column",
          "kind": "int",
          "default": 0
        },
        {
          "key": "rowspan",
          "label": "Row span",
          "kind": "int",
          "optional": true
        },
        {
          "key": "columnspan",
          "label": "Column span",
          "kind": "int",
          "optional": true
        },
        {
          "key": "sticky",
          "label": "Sticky",
          "kind": "string",
          "optional": true
        },
        {
          "key": "padx",
          "label": "Pad X",
          "kind": "int",
          "optional": true
        },
        {
          "key": "pady",
          "label": "Pad Y",
          "kind": "int",
          "optional": true
        }
      ],
      "code": "{name}.grid({args})"
    },
    "place": {
      "props": [
        {
          "key": "x",
          "label": "X",
          "kind": "int",
          "default": 0
        },
        {
          "key": "y",
          "label": "Y",
          "kind": "int",
          "default": 0
        },
        {
          "key": "width",
          "label": "Width",
          "kind": "int",
          "optional": true
        },
        {
          "key": "height",
          "label": "Height",
          "kind": "int",
          "optional": true
        }
      ],
      "code": "{name}.place({args})"
    },
    "pack": {
      "props": [
        {
          "key": "side",
          "label": "Side",
          "kind": "enum",
          "options": [
            "top",
            "bottom",
            "left",
            "right"
          ],
          "default": "top",
          "omit_when": "top"
        },
        {
          "key": "fill",
          "label": "Fill",
          "kind": "enum",
          "options": [
            "none",
            "x",
            "y",
            "both"
          ],
          "default": "none",
          "omit_when": "none"
        },
        {
          "key": "expand",
          "label": "Expand",
          "kind": "bool",
          "default": false,
          "omit_when": false
        },
        {
          "key": "padx",
          "label": "Pad X",
          "kind": "int",
          "optional": true
        },
        {
          "key": "pady",
          "label": "Pad Y",
          "kind": "int",
          "optional": true
        },
        {
          "key": "anchor",
          "label": "Anchor",
          "kind": "string",
          "optional": true
        }
      ],
      "code": "{name}.pack({args})"
    }
  },
  "visibility": [
    "widgets = dict(locals())",
    "saved = {}",
    "def hide_widget(name):",
    "    w = widgets[name]",
    "    manager = w.winfo_manager()",
    "    if manager and name not in saved:",
    "        saved[name] = (manager, getattr(w, manager + '_info')())",
    "        getattr(w, manager + '_forget')()",
    "def show_widget(name):",
    "    if name in saved:",
    "        manager, info = saved.pop(name)",
    "        getattr(widgets[name], manager)(**info)",
    "screens = [{screens}]",
    "def show_screen(name):",
    "    for other in screens:",
    "        hide_widget(other)",
    "    show_widget(name)"
  ],
  "actions": [
    "def set_text(name, text):",
    "    w = widgets[name]",
    "    kind = type(w).__name__",
    "    if kind == 'CTkTextbox':",
    "        w.delete('0.0', 'end')",
    "        w.insert('0.0', text)",
    "    elif kind == 'CTkEntry':",
    "        w.delete(0, 'end')",
    "        w.insert(0, text)",
    "    elif kind in ('CTkComboBox', 'CTkOptionMenu'):",
    "        w.set(text)",
    "    else:",
    "        w.configure(text=text)",
    "def get_text(name):",
    "    w = widgets[name]",
    "    kind = type(w).__name__",
    "    if kind == 'CTkTextbox':",
    "        return w.get('0.0', 'end-1c')",
    "    if kind in ('CTkEntry', 'CTkComboBox', 'CTkOptionMenu'):",
    "        return w.get()",
    "    return str(w.cget('text'))",
    "def set_enabled(name, enabled=True):",
    "    widgets[name].configure(state='normal' if enabled else 'disabled')",
    "def set_value(name, value):",
    "    w = widgets[name]",
    "    if hasattr(w, 'select') and hasattr(w, 'deselect'):",
    "        w.select() if value else w.deselect()",
    "    else:",
    "        w.set(value)",
    "def get_value(name):",
    "    w = widgets[name]",
    "    value = w.get()",
    "    return bool(value) if hasattr(w, 'select') else value",
    "def move_widget(name, x, y):",
    "    widgets[name].place(x=x, y=y)",
    "def resize_widget(name, width, height):",
    "    widgets[name].configure(width=width, height=height)",
    "def set_option(name, option, value):",
    "    widgets[name].configure(**{option: value})"
  ],
  "options": [
    "text",
    "state",
    "text_color",
    "fg_color",
    "font",
    "width",
    "height"
  ]
}
