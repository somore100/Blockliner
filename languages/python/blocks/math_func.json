{
  "display_name": "Math Function",
  "category": "Math",
  "description": "Square root, round down, round up or absolute value. The file gets 'import math'.",
  "requires": [
    "math"
  ],
  "template": "[[variable]] = math.[[func]]([[value]])\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "result"
    },
    {
      "name": "func",
      "type": "choice",
      "default": "sqrt",
      "choices": [
        "sqrt",
        "floor",
        "ceil",
        "fabs"
      ]
    },
    {
      "name": "value",
      "type": "expression",
      "default": "16"
    }
  ]
}
