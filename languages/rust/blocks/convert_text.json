{
  "display_name": "Text To Number",
  "category": "Basic",
  "description": "Turns text into a whole number (stops with an error if it is not one).",
  "template": "let [[variable]]: i32 = [[text]].trim().parse().unwrap();\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "number"
    },
    {
      "name": "text",
      "type": "variable",
      "default": "text"
    }
  ]
}
