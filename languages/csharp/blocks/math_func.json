{
  "display_name": "Math Function",
  "category": "Math",
  "description": "Square root, round down, round up or absolute value.",
  "template": "double [[variable]] = Math.[[func]]([[value]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "result"
    },
    {
      "name": "func",
      "type": "choice",
      "default": "Sqrt",
      "choices": [
        "Sqrt",
        "Floor",
        "Ceiling",
        "Abs"
      ]
    },
    {
      "name": "value",
      "type": "expression",
      "default": "16"
    }
  ]
}
