{
  "type": "button",
  "label": "Button",
  "description": "A clickable button. Use 'On press' to choose the function it runs.",
  "category": "Basic",
  "icon": "▭",
  "container": false,
  "default_size": [
    100,
    32
  ],
  "props": [
    {
      "key": "text",
      "label": "Text",
      "kind": "string",
      "default": "Button"
    },
    {
      "key": "font_size",
      "label": "Text size",
      "kind": "int",
      "optional": true
    },
    {
      "key": "disabled",
      "label": "Disabled",
      "kind": "bool",
      "default": false,
      "omit_when": false
    }
  ],
  "events": [
    {
      "key": "press",
      "label": "On press",
      "args": [
        "instance"
      ],
      "code": "{name}.bind(on_press={handler})"
    }
  ],
  "code": [
    "{name} = Button({args})",
    "{parent}.add_widget({name})"
  ]
}
