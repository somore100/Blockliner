{
  "display_name": "Split Text",
  "category": "String Operations",
  "description": "Cuts text into a list at a separator.",
  "template": "string[] [[variable]] = [[text]].Split([[sep]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "parts"
    },
    {
      "name": "text",
      "type": "variable",
      "default": "line"
    },
    {
      "name": "sep",
      "type": "expression",
      "default": "\",\""
    }
  ]
}
