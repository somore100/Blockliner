{
  "concept_id": "input",
  "display_name": "Input",
  "category": "Basic",
  "description": "Reads one word from the keyboard into a new string variable.",
  "template": "var [[variable]] string\nfmt.Print(\"[[prompt]]\")\nfmt.Scanln(&[[variable]])\n",
  "params": [
    {
      "name": "variable",
      "type": "identifier",
      "default": "name"
    },
    {
      "name": "prompt",
      "type": "string",
      "default": "Enter a value: "
    }
  ]
}
