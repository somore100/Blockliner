{
  "display_name": "Take Last From List",
  "category": "Data Structures",
  "description": "Removes the last item of a list and keeps it in a variable.",
  "template": "[[variable]] = [[list]].pop()\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "last"
    },
    {
      "name": "list",
      "type": "identifier",
      "default": "my_list"
    }
  ]
}
