{
  "display_name": "Random Item",
  "category": "Math",
  "description": "Picks one item of a list at random. The file gets 'import random'.",
  "requires": [
    "random"
  ],
  "template": "[[variable]] = random.choice([[items]])\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "pick"
    },
    {
      "name": "items",
      "type": "expression",
      "default": "my_list"
    }
  ]
}
