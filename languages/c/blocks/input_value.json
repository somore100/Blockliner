{
  "concept_id": "input",
  "display_name": "Input",
  "category": "Basic",
  "description": "Reads one word from the keyboard into a new char array (declares the variable). Use raw_code for other types.",
  "template": "char [[variable]][256];\nprintf(\"[[prompt]]\");\nscanf(\"%255s\", [[variable]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "identifier",
      "default": "name"
    },
    {
      "name": "prompt",
      "type": "string",
      "default": "Enter a value: "
    }
  ]
}
