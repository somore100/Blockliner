{
  "display_name": "Text To Number",
  "category": "Basic",
  "description": "Turns text into a whole number.",
  "template": "int [[variable]] = Integer.parseInt([[text]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "number"
    },
    {
      "name": "text",
      "type": "variable",
      "default": "text"
    }
  ]
}
