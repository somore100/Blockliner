{
  "display_name": "Round Number",
  "category": "Math",
  "description": "Rounds a number to the nearest whole number.",
  "requires": [
    "cmath"
  ],
  "template": "double [[variable]] = std::round([[value]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "rounded"
    },
    {
      "name": "value",
      "type": "expression",
      "default": "3.7"
    }
  ]
}
