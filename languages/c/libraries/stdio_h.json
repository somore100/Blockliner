{
  "name": "stdio.h",
  "import": "#include <stdio.h>",
  "description": "Input and output",
  "commands": [
    {
      "name": "printf",
      "use": "printf",
      "signature": "printf(format, ...)",
      "does": "Print formatted text"
    },
    {
      "name": "scanf",
      "use": "scanf",
      "signature": "scanf(format, ...)",
      "does": "Read formatted input"
    },
    {
      "name": "fopen",
      "use": "fopen",
      "signature": "fopen(path, mode)",
      "does": "Open a file (close it with fclose)"
    },
    {
      "name": "fclose",
      "use": "fclose",
      "signature": "fclose(file)",
      "does": "Close a file"
    }
  ]
}