{
  "display_name": "Move Widget",
  "category": "GUI",
  "description": "Moves a widget to a spot in the window (x across, y down, in pixels from the top left). The widget then stays placed by x and y.",
  "template": "ui.move_widget('[[widget]]', [[x]], [[y]])\n",
  "params": [
    {
      "name": "widget",
      "type": "identifier",
      "default": "",
      "choices": "@ui_widgets"
    },
    {
      "name": "x",
      "type": "expression",
      "default": "0"
    },
    {
      "name": "y",
      "type": "expression",
      "default": "0"
    }
  ]
}
