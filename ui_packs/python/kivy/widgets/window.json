{
  "type": "window",
  "label": "Window",
  "description": "The window of your program. Everything else goes inside it.",
  "category": "Window",
  "icon": "🗔",
  "container": true,
  "default_size": [
    400,
    300
  ],
  "props": [
    {
      "key": "title",
      "label": "Title",
      "kind": "string",
      "default": "My app",
      "inline": true
    },
    {
      "key": "width",
      "label": "Width",
      "kind": "int",
      "default": 400,
      "inline": true
    },
    {
      "key": "height",
      "label": "Height",
      "kind": "int",
      "default": 300,
      "inline": true
    }
  ],
  "events": [],
  "code": [
    "{name} = RelativeLayout()",
    "Window.size = ({width}, {height})",
    "{name}.title = {title!r}"
  ]
}
