{
  "display_name": "Random Whole Number",
  "category": "Math",
  "description": "A random whole number from 0 up to but not including the limit.",
  "template": "let [[variable]] = Math.floor(Math.random() * [[limit]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "roll"
    },
    {
      "name": "limit",
      "type": "expression",
      "default": "6"
    }
  ]
}
