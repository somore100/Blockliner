{
  "display_name": "Get Item",
  "category": "Data Structures",
  "description": "Reads one entry of a list (by position) or a dictionary (by key).",
  "template": "[[variable]] = [[name]][[[key]]]\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "value"
    },
    {
      "name": "name",
      "type": "variable",
      "default": "my_dict"
    },
    {
      "name": "key",
      "type": "expression",
      "default": "\"a\""
    }
  ]
}
