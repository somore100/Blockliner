{
  "display_name": "Read Widget Text",
  "category": "GUI",
  "description": "Puts what is typed in an input box (or chosen in a dropdown) into a variable.",
  "template": "[[variable]] = ui.[[widget]].get()\n",
  "params": [
    {
      "name": "variable",
      "type": "identifier",
      "default": "answer"
    },
    {
      "name": "widget",
      "type": "identifier",
      "default": "",
      "choices": "@ui_widgets"
    }
  ]
}
