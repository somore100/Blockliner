{
  "concept_id": "input",
  "display_name": "Input",
  "category": "Basic",
  "description": "Reads a line of text into a new string variable.",
  "template": "Console.Write(\"[[prompt]]\");\nstring [[variable]] = Console.ReadLine();\n",
  "params": [
    {
      "name": "variable",
      "type": "identifier",
      "default": "name"
    },
    {
      "name": "prompt",
      "type": "string",
      "default": "Enter a value: "
    }
  ]
}
