{
  "display_name": "Join List",
  "category": "String Operations",
  "description": "Glues the items of a list into one text.",
  "requires": [
    "strings"
  ],
  "template": "[[variable]] := strings.Join([[list]], [[sep]])\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "joined"
    },
    {
      "name": "list",
      "type": "expression",
      "default": "parts"
    },
    {
      "name": "sep",
      "type": "expression",
      "default": "\"-\""
    }
  ]
}
