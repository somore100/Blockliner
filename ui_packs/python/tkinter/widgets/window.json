{
  "type": "window",
  "label": "Window",
  "category": "Window",
  "icon": "🗔",
  "container": true,
  "default_size": [
    400,
    300
  ],
  "props": [
    {
      "key": "title",
      "label": "Title",
      "kind": "string",
      "default": "My app",
      "inline": true
    },
    {
      "key": "geometry",
      "label": "Size",
      "kind": "string",
      "default": "400x300",
      "inline": true
    }
  ],
  "events": [],
  "code": [
    "{name} = tk.Tk()",
    "{name}.title({title!r})",
    "{name}.geometry({geometry!r})"
  ]
}