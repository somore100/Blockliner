{
  "type": "entry",
  "label": "Input box",
  "description": "A one-line box where the user types text.",
  "category": "Input",
  "icon": "▁",
  "container": false,
  "default_size": [
    140,
    28
  ],
  "props": [
    {
      "key": "width",
      "label": "Width (px)",
      "kind": "int",
      "optional": true
    },
    {
      "key": "show",
      "label": "Mask character",
      "kind": "string",
      "optional": true
    },
    {
      "key": "state",
      "label": "State",
      "kind": "enum",
      "default": "normal",
      "options": [
        "normal",
        "disabled"
      ],
      "omit_when": "normal"
    },
    {
      "key": "font",
      "label": "Font",
      "kind": "font",
      "optional": true
    },
    {
      "key": "foreground",
      "label": "Text colour",
      "kind": "color",
      "optional": true,
      "arg": "text_color"
    }
  ],
  "events": [
    {
      "key": "return",
      "label": "On Enter",
      "args": [
        "event"
      ],
      "code": "{name}.bind('<Return>', {handler})"
    }
  ],
  "code": "{name} = ctk.CTkEntry({parent}{opts})"
}
