{
  "format": "blockliner-ui-pack",
  "version": 1,
  "id": "python/kivy",
  "language": "python",
  "label": "kivy",
  "description": "Kivy: touch-friendly apps for desktop and phones. Needs one install: pip install kivy.",
  "priority": 20,
  "imports": [
    "from kivy.app import App",
    "from kivy.core.window import Window",
    "from kivy.uix.relativelayout import RelativeLayout",
    "from kivy.uix.label import Label",
    "from kivy.uix.button import Button",
    "from kivy.uix.togglebutton import ToggleButton",
    "from kivy.uix.checkbox import CheckBox",
    "from kivy.uix.switch import Switch",
    "from kivy.uix.textinput import TextInput",
    "from kivy.uix.spinner import Spinner",
    "from kivy.uix.slider import Slider",
    "from kivy.uix.progressbar import ProgressBar",
    "from kivy.uix.image import Image",
    "import types"
  ],
  "header": [
    "",
    "",
    "class UIApp(App):",
    "    @classmethod",
    "    def run_with(cls, root_widget):",
    "        app = cls()",
    "        app.ui_root = root_widget",
    "        app.title = getattr(root_widget, 'title', 'App')",
    "        app.run()",
    "",
    "    def build(self):",
    "        return self.ui_root",
    "",
    "def place(parent, widget, x=0, y=0, width=100, height=30):",
    "    widget.size_hint = (None, None)",
    "    widget.size = (width, height)",
    "    widget.pos = (x, parent.height - y - height)",
    "    parent.bind(height=lambda _w, h: setattr(widget, 'pos', (x, h - y - height)))"
  ],
  "root_types": [
    "window"
  ],
  "run": "UIApp.run_with({ui}.{root})",
  "preview": "boxes",
  "layouts": {
    "place": {
      "props": [
        {
          "key": "x",
          "label": "X",
          "kind": "int",
          "default": 0
        },
        {
          "key": "y",
          "label": "Y",
          "kind": "int",
          "default": 0
        },
        {
          "key": "width",
          "label": "Width",
          "kind": "int",
          "optional": true
        },
        {
          "key": "height",
          "label": "Height",
          "kind": "int",
          "optional": true
        }
      ],
      "code": "place({parent}, {name}, {args})"
    }
  },
  "order": [
    "window",
    "frame",
    "label",
    "button",
    "togglebutton",
    "checkbutton",
    "switch",
    "entry",
    "text",
    "combobox",
    "scale",
    "progressbar",
    "image"
  ],
  "quote": "python",
  "function": {
    "def": "def {fname}():",
    "indent": "    ",
    "ret": "return types.SimpleNamespace({pairs})",
    "pair": "{name}={name}",
    "call": "{ui} = {fname}()"
  },
  "visibility": [
    "widgets = dict(locals())",
    "def hide_widget(name):",
    "    widgets[name].opacity = 0",
    "    widgets[name].disabled = True",
    "def show_widget(name):",
    "    widgets[name].opacity = 1",
    "    widgets[name].disabled = False",
    "screens = [{screens}]",
    "def show_screen(name):",
    "    for other in screens:",
    "        hide_widget(other)",
    "    show_widget(name)"
  ]
}
