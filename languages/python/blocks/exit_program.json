{
  "display_name": "Exit Program",
  "category": "Basic",
  "description": "Stops the program. The file gets 'import sys' at the top.",
  "requires": [
    "sys"
  ],
  "template": "sys.exit([[code]])\n",
  "params": [
    {
      "name": "code",
      "type": "expression",
      "default": "0"
    }
  ]
}
