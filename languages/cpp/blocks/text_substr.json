{
  "display_name": "Part Of Text",
  "category": "String Operations",
  "description": "Cuts a piece out of a text.",
  "template": "std::string [[variable]] = [[text]].substr([[start]], [[length]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "piece"
    },
    {
      "name": "text",
      "type": "variable",
      "default": "text"
    },
    {
      "name": "start",
      "type": "expression",
      "default": "0"
    },
    {
      "name": "length",
      "type": "expression",
      "default": "3"
    }
  ]
}
