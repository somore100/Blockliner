{
  "display_name": "Get Entry",
  "category": "Data Structures",
  "description": "Reads a value from a list or object at a key or position.",
  "template": "let [[variable]] = [[target]][[[key]]];\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "value"
    },
    {
      "name": "target",
      "type": "variable",
      "default": "scores"
    },
    {
      "name": "key",
      "type": "expression",
      "default": "\"b\""
    }
  ]
}
