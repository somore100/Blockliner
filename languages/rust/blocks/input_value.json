{
  "concept_id": "input",
  "display_name": "Input",
  "category": "Basic",
  "description": "Reads a line (including the newline) into a new String variable.",
  "template": "print!(\"[[prompt]]\");\nlet mut [[variable]] = String::new();\nstd::io::stdin().read_line(&mut [[variable]]).unwrap();\n",
  "params": [
    {
      "name": "variable",
      "type": "identifier",
      "default": "name"
    },
    {
      "name": "prompt",
      "type": "string",
      "default": "Enter a value: "
    }
  ]
}
