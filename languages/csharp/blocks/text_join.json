{
  "display_name": "Join List",
  "category": "String Operations",
  "description": "Glues the items of a list into one text.",
  "template": "string [[variable]] = string.Join([[sep]], [[list]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "joined"
    },
    {
      "name": "sep",
      "type": "expression",
      "default": "\"-\""
    },
    {
      "name": "list",
      "type": "variable",
      "default": "parts"
    }
  ]
}
