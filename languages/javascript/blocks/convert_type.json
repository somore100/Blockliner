{
  "display_name": "Convert Type",
  "category": "Basic",
  "description": "Turns a value into a number, whole number, text or true/false.",
  "template": "let [[variable]] = [[type]]([[value]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "number"
    },
    {
      "name": "type",
      "type": "choice",
      "default": "Number",
      "choices": [
        "Number",
        "parseInt",
        "parseFloat",
        "String",
        "Boolean"
      ]
    },
    {
      "name": "value",
      "type": "expression",
      "default": "text"
    }
  ]
}
