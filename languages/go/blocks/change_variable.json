{
  "display_name": "Change Variable",
  "category": "Basic",
  "description": "Changes an existing variable: set it, add to it, subtract and so on.",
  "template": "[[variable]] [[op]] [[value]]\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "total"
    },
    {
      "name": "op",
      "type": "choice",
      "default": "+=",
      "choices": [
        "+=",
        "-=",
        "*=",
        "/=",
        "%="
      ]
    },
    {
      "name": "value",
      "type": "expression",
      "default": "1"
    }
  ]
}
