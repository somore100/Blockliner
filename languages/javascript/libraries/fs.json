{
  "name": "fs",
  "import": "const fs = require(\"fs\");",
  "description": "Read and write files (Node.js)",
  "commands": [
    {
      "name": "readFileSync",
      "use": "fs.readFileSync",
      "signature": "fs.readFileSync(path, 'utf8')",
      "does": "Whole file as text",
      "example": "fs.readFileSync(\"file.txt\", \"utf8\")"
    },
    {
      "name": "writeFileSync",
      "use": "fs.writeFileSync",
      "signature": "fs.writeFileSync(path, text)",
      "does": "Write text to a file",
      "example": "fs.writeFileSync(\"file.txt\", \"hello\")"
    },
    {
      "name": "existsSync",
      "use": "fs.existsSync",
      "signature": "fs.existsSync(path)",
      "does": "Does it exist?",
      "example": "fs.existsSync(\"file.txt\")"
    }
  ],
  "namespace": "fs"
}