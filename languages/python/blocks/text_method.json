{
  "display_name": "Change Text",
  "category": "String Operations",
  "description": "Makes a new text: UPPER, lower, trimmed, Title Case...",
  "template": "[[variable]] = [[text]].[[method]]()\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "result"
    },
    {
      "name": "text",
      "type": "expression",
      "default": "name"
    },
    {
      "name": "method",
      "type": "choice",
      "default": "upper",
      "choices": [
        "upper",
        "lower",
        "strip",
        "title",
        "capitalize"
      ]
    }
  ]
}
