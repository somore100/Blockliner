{
  "type": "label",
  "label": "Label",
  "description": "Text the user reads but cannot edit.",
  "category": "Basic",
  "icon": "A",
  "container": false,
  "default_size": [
    80,
    24
  ],
  "props": [
    {
      "key": "text",
      "label": "Text",
      "kind": "string",
      "default": "Label"
    },
    {
      "key": "width",
      "label": "Width (px)",
      "kind": "int",
      "optional": true
    },
    {
      "key": "font",
      "label": "Font",
      "kind": "font",
      "optional": true
    },
    {
      "key": "foreground",
      "label": "Text colour",
      "kind": "color",
      "optional": true,
      "arg": "text_color"
    },
    {
      "key": "background",
      "label": "Background",
      "kind": "color",
      "optional": true,
      "arg": "fg_color"
    }
  ],
  "events": [],
  "code": "{name} = ctk.CTkLabel({parent}{opts})"
}
