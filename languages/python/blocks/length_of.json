{
  "display_name": "Length Of",
  "category": "Basic",
  "description": "Counts the items in a list or the characters in text.",
  "template": "[[variable]] = len([[value]])\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "size"
    },
    {
      "name": "value",
      "type": "expression",
      "default": "my_list"
    }
  ]
}
