{
  "display_name": "Sleep",
  "category": "Basic",
  "description": "Waits for a number of seconds. The file gets 'import time' at the top.",
  "requires": ["time"],
  "template": "time.sleep([[seconds]])\n",
  "params": [
    {
      "name": "seconds",
      "type": "expression",
      "default": "1"
    }
  ]
}
