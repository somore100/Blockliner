{
  "display_name": "Decimal Number",
  "category": "Basic",
  "description": "Makes a decimal number variable.",
  "template": "double [[variable]] = [[value]];\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "price"
    },
    {
      "name": "value",
      "type": "expression",
      "default": "0.0"
    }
  ]
}
