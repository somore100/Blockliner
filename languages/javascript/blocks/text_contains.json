{
  "display_name": "Contains",
  "category": "String Operations",
  "description": "True or false: does the text or list contain this?",
  "template": "let [[variable]] = [[text]].includes([[part]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "found"
    },
    {
      "name": "text",
      "type": "variable",
      "default": "text"
    },
    {
      "name": "part",
      "type": "expression",
      "default": "\"a\""
    }
  ]
}
