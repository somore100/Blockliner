{
  "type": "segmented",
  "label": "Segmented button",
  "description": "A row of buttons where one is selected.",
  "category": "Input",
  "icon": "▤",
  "container": false,
  "default_size": [
    180,
    28
  ],
  "props": [
    {
      "key": "values",
      "label": "Choices",
      "kind": "list",
      "default": [
        "one",
        "two"
      ]
    }
  ],
  "events": [
    {
      "key": "command",
      "label": "On select",
      "args": [
        "value"
      ],
      "code": "{name}.configure(command={handler})"
    }
  ],
  "code": "{name} = ctk.CTkSegmentedButton({parent}{opts})"
}
