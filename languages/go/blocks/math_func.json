{
  "display_name": "Math Function",
  "category": "Math",
  "description": "Square root, round down, round up or absolute value.",
  "requires": [
    "math"
  ],
  "template": "[[variable]] := math.[[func]]([[value]])\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "result"
    },
    {
      "name": "func",
      "type": "choice",
      "default": "Sqrt",
      "choices": [
        "Sqrt",
        "Floor",
        "Ceil",
        "Abs"
      ]
    },
    {
      "name": "value",
      "type": "expression",
      "default": "16"
    }
  ]
}
