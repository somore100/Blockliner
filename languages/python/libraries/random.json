    },
    {
      "name": "shuffle",
      "use": "random.shuffle",
      "signature": "random.shuffle(items)",
      "does": "Mix a list in place",
      "example": "random.shuffle(items)"
    }
  ],
  "namespace": "random",
  "installed_module": "random"
