{
  "display_name": "Text Change",
  "category": "String Operations",
  "description": "Makes text upper case, lower case or trims the spaces.",
  "template": "let [[variable]] = [[text]].[[method]]();\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "shout"
    },
    {
      "name": "text",
      "type": "variable",
      "default": "name"
    },
    {
      "name": "method",
      "type": "choice",
      "default": "to_uppercase",
      "choices": [
        "to_uppercase",
        "to_lowercase",
        "trim"
      ]
    }
  ]
}
