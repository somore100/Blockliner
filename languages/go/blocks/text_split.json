{
  "display_name": "Split Text",
  "category": "String Operations",
  "description": "Cuts text into a list at a separator.",
  "requires": [
    "strings"
  ],
  "template": "[[variable]] := strings.Split([[text]], [[sep]])\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "parts"
    },
    {
      "name": "text",
      "type": "expression",
      "default": "line"
    },
    {
      "name": "sep",
      "type": "expression",
      "default": "\",\""
    }
  ]
}
