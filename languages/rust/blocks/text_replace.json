{
  "display_name": "Replace In Text",
  "category": "String Operations",
  "description": "Swaps every copy of one piece of text for another.",
  "template": "let [[variable]] = [[text]].replace([[old]], [[new]]);\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "fixed"
    },
    {
      "name": "text",
      "type": "variable",
      "default": "text"
    },
    {
      "name": "old",
      "type": "expression",
      "default": "\"a\""
    },
    {
      "name": "new",
      "type": "expression",
      "default": "\"b\""
    }
  ]
}
