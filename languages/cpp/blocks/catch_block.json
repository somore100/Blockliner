{
  "display_name": "Catch",
  "category": "Control",
  "description": "Runs when the Try block before it hit an error.",
  "is_container": true,
  "template": "catch (const std::exception& [[error]]) {\n[[body]]\n}\n",
  "params": [
    {
      "name": "error",
      "type": "variable",
      "default": "e"
    }
  ]
}
