{
  "name": "algorithm",
  "import": "#include <algorithm>",
  "description": "Sorting, searching, min and max",
  "commands": [
    {
      "name": "sort",
      "use": "std::sort",
      "signature": "std::sort(v.begin(), v.end())",
      "does": "Sort a list",
      "example": "std::sort(v.begin(), v.end())"
    },
    {
      "name": "reverse",
      "use": "std::reverse",
      "signature": "std::reverse(v.begin(), v.end())",
      "does": "Turn a list around",
      "example": "std::reverse(v.begin(), v.end())"
    },
    {
      "name": "max",
      "use": "std::max",
      "signature": "std::max(a, b)",
      "does": "The bigger of two",
      "example": "std::max(1, 2)"
    },
    {
      "name": "min",
      "use": "std::min",
      "signature": "std::min(a, b)",
      "does": "The smaller of two",
      "example": "std::min(1, 2)"
    }
  ]
}