{
  "display_name": "Contains",
  "category": "String Operations",
  "description": "True or false: does the text contain this?",
  "template": "bool [[variable]] = [[text]].find([[part]]) != std::string::npos;\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "found"
    },
    {
      "name": "text",
      "type": "variable",
      "default": "text"
    },
    {
      "name": "part",
      "type": "expression",
      "default": "\"a\""
    }
  ]
}
