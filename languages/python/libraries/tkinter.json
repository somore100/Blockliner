{
  "name": "tkinter",
  "import": "import tkinter as tk",
  "description": "Windows and buttons (GUI)",
  "commands": [
    {
      "name": "Tk",
      "use": "tk.Tk",
      "signature": "tk.Tk()",
      "does": "The main window",
      "example": "tk.Tk()"
    },
    {
      "name": "Label",
      "use": "tk.Label",
      "signature": "tk.Label(parent, text=...)",
      "does": "A line of text",
      "example": "tk.Label(root, text=\"Hello\")"
    },
    {
      "name": "Button",
      "use": "tk.Button",
      "signature": "tk.Button(parent, text=...)",
      "does": "A clickable button",
      "example": "tk.Button(root, text=\"Click\")"
    }
  ],
  "namespace": "tk",
  "installed_module": "tkinter"
}