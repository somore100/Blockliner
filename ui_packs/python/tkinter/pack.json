{
  "format": "blockliner-ui-pack",
  "version": 1,
  "id": "python/tkinter",
  "language": "python",
  "label": "tkinter",
  "description": "Python's built-in UI library. Nothing to install; plain, classic desktop windows.",
  "priority": 0,
  "imports": [
    "import tkinter as tk",
    "from tkinter import ttk",
    "import types"
  ],
  "header": [],
  "root_types": [
    "window",
    "popup"
  ],
  "run": "{ui}.{root}.mainloop()",
  "preview": "native",
  "layouts": {
    "grid": {
      "props": [
        {
          "key": "row",
          "label": "Row",
          "kind": "int",
          "default": 0
        },
        {
          "key": "column",
          "label": "Column",
          "kind": "int",
          "default": 0
        },
        {
          "key": "rowspan",
          "label": "Row span",
          "kind": "int",
          "optional": true
        },
        {
          "key": "columnspan",
          "label": "Column span",
          "kind": "int",
          "optional": true
        },
        {
          "key": "sticky",
          "label": "Sticky",
          "kind": "string",
          "optional": true
        },
        {
          "key": "padx",
          "label": "Pad X",
          "kind": "int",
          "optional": true
        },
        {
          "key": "pady",
          "label": "Pad Y",
          "kind": "int",
          "optional": true
        }
      ],
      "code": "{name}.grid({args})"
    },
    "place": {
      "props": [
        {
          "key": "x",
          "label": "X",
          "kind": "int",
          "default": 0
        },
        {
          "key": "y",
          "label": "Y",
          "kind": "int",
          "default": 0
        },
        {
          "key": "width",
          "label": "Width",
          "kind": "int",
          "optional": true
        },
        {
          "key": "height",
          "label": "Height",
          "kind": "int",
          "optional": true
        }
      ],
      "code": "{name}.place({args})"
    }
  },
  "order": [
    "window",
    "popup",
    "frame",
    "label",
    "button",
    "checkbutton",
    "entry",
    "text",
    "combobox",
    "listbox",
    "treeview",
    "scrollbar",
    "hscrollbar",
    "radiobutton",
    "scale",
    "spinbox",
    "progressbar",
    "separator",
    "labelframe",
    "canvas"
  ],
  "quote": "python",
  "function": {
    "def": "def {fname}():",
    "indent": "    ",
    "ret": "return types.SimpleNamespace({pairs})",
    "pair": "{name}={name}",
    "call": "{ui} = {fname}()"
  },
  "visibility": [
    "widgets = dict(locals())",
    "saved = {}",
    "def hide_widget(name):",
    "    w = widgets[name]",
    "    manager = w.winfo_manager()",
    "    if manager and name not in saved:",
    "        saved[name] = (manager, getattr(w, manager + '_info')())",
    "        getattr(w, manager + '_forget')()",
    "def show_widget(name):",
    "    if name in saved:",
    "        manager, info = saved.pop(name)",
    "        getattr(widgets[name], manager)(**info)",
    "screens = [{screens}]",
    "def show_screen(name):",
    "    for other in screens:",
    "        hide_widget(other)",
    "    show_widget(name)"
  ],
  "actions": [
    "def set_text(name, text):",
    "    w = widgets[name]",
    "    if isinstance(w, tk.Text):",
    "        w.delete('1.0', 'end')",
    "        w.insert('1.0', text)",
    "    elif isinstance(w, ttk.Combobox):",
    "        w.set(text)",
    "    elif isinstance(w, tk.Entry):",
    "        w.delete(0, 'end')",
    "        w.insert(0, text)",
    "    else:",
    "        w.configure(text=text)",
    "def get_text(name):",
    "    w = widgets[name]",
    "    if isinstance(w, tk.Text):",
    "        return w.get('1.0', 'end-1c')",
    "    if isinstance(w, tk.Entry):",
    "        return w.get()",
    "    return str(w.cget('text'))",
    "def set_enabled(name, enabled=True):",
    "    w = widgets[name]",
    "    if isinstance(w, ttk.Widget):",
    "        w.state(['!disabled' if enabled else 'disabled'])",
    "    else:",
    "        w.configure(state='normal' if enabled else 'disabled')",
    "def set_value(name, value):",
    "    w = widgets[name]",
    "    if isinstance(w, ttk.Progressbar):",
    "        w['value'] = value",
    "    elif isinstance(w, tk.Checkbutton):",
    "        w.select() if value else w.deselect()",
    "    else:",
    "        w.set(value)",
    "def get_value(name):",
    "    w = widgets[name]",
    "    if isinstance(w, ttk.Progressbar):",
    "        return float(w['value'])",
    "    if isinstance(w, tk.Checkbutton):",
    "        return bool(int(w.getvar(str(w.cget('variable')))))",
    "    return w.get()",
    "def move_widget(name, x, y):",
    "    widgets[name].place(x=x, y=y)",
    "def resize_widget(name, width, height):",
    "    w = widgets[name]",
    "    if w.winfo_manager() == 'place':",
    "        w.place_configure(width=width, height=height)",
    "    else:",
    "        w.configure(width=width, height=height)",
    "def set_option(name, option, value):",
    "    widgets[name].configure(**{option: value})"
  ],
  "options": [
    "text",
    "state",
    "foreground",
    "background",
    "font",
    "width"
  ]
}