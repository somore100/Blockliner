{
  "display_name": "Replace In Text",
  "category": "String Operations",
  "description": "Swaps every copy of one piece of text for another.",
  "requires": [
    "strings"
  ],
  "template": "[[variable]] := strings.ReplaceAll([[text]], [[old]], [[new]])\n",
  "params": [
    {
      "name": "variable",
      "type": "variable",
      "default": "fixed"
    },
    {
      "name": "text",
      "type": "expression",
      "default": "text"
    },
    {
      "name": "old",
      "type": "expression",
      "default": "\"a\""
    },
    {
      "name": "new",
      "type": "expression",
      "default": "\"b\""
    }
  ]
}
